// Main.kt
const val N = 8 // 체스판 크기

val board = IntArray(N) // board[i]는 i번째 행에 있는 퀸의 열 위치
var solutionCount = 0 // 정답 개수 카운트

// 현재 위치에 퀸을 놓을 수 있는지 확인
fun isSafe(row: Int, col: Int): Boolean {
    for (i in 0 until row) {
        if (board[i] == col || Math.abs(row - i) == Math.abs(col - board[i])) {
            return false
        }
    }
    return true
}

// 백트래킹으로 퀸을 배치
fun solve(row: Int) {
    if (row == N) {
        printBoard()
        solutionCount++
        return
    }

    for (col in 0 until N) {
        if (isSafe(row, col)) {
            board[row] = col
            solve(row + 1)
        }
    }
}

// 체스판 출력
fun printBoard() {
    println("해 ${solutionCount + 1}:")
    for (i in 0 until N) {
        for (j in 0 until N) {
            if (board[i] == j) print("Q ") else print(". ")
        }
        println()
    }
    println()
}

fun main() {
    solve(0)
    println("총 ${solutionCount}개의 해가 있습니다.")
}

# ♟️ 8-Queens Problem (Kotlin)

이 프로젝트는 **8퀸 문제(8-Queens Problem)** 를 Kotlin으로 해결한 예제입니다.  
퀸(Queen)은 체스에서 가로, 세로, 대각선으로 이동할 수 있으며, 서로 공격하지 않도록 배치해야 합니다.

---

## 🧠 문제 설명

- **목표**: 8×8 체스판에 8개의 퀸을 서로 공격하지 않게 놓는 것
- **조건**:
  - 같은 행, 열에 둘 수 없음
  - 대각선 상에도 놓을 수 없음

---

## 💡 해결 방법

- **백트래킹 (Backtracking)** 알고리즘 사용
- 한 행씩 퀸을 놓아가며 가능한 모든 경우를 탐색
- 퀸을 놓을 수 없으면 이전 단계로 되돌아감

